{
  "components": {
    "schemas": {
      "Case": {
        "$defs": {
          "DataClass": {
            "enum": [
              "synthetic",
              "deidentified_research"
            ],
            "type": "string"
          },
          "EvidenceKind": {
            "enum": [
              "histology",
              "ihc",
              "molecular",
              "clinical"
            ],
            "type": "string"
          },
          "Finding": {
            "additionalProperties": false,
            "properties": {
              "id": {
                "pattern": "^[A-Za-z0-9_-]{1,64}$",
                "type": "string"
              },
              "kind": {
                "$ref": "#/components/schemas/Case/$defs/EvidenceKind"
              },
              "name": {
                "description": "Nonblank; limit is measured in UTF-8 bytes by the runtime validator.",
                "maxLength": 128,
                "minLength": 1,
                "type": "string",
                "x-maxUtf8Bytes": 128
              },
              "value": {
                "description": "Nonblank; limit is measured in UTF-8 bytes by the runtime validator.",
                "maxLength": 1024,
                "minLength": 1,
                "type": "string",
                "x-maxUtf8Bytes": 1024
              }
            },
            "required": [
              "id",
              "kind",
              "name",
              "value"
            ],
            "type": "object"
          },
          "SexAtBirth": {
            "enum": [
              "female",
              "male",
              "intersex",
              "unknown"
            ],
            "type": "string"
          }
        },
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "additionalProperties": false,
        "properties": {
          "age_years": {
            "format": "uint8",
            "maximum": 120,
            "minimum": 0,
            "type": [
              "integer",
              "null"
            ]
          },
          "case_id": {
            "pattern": "^[A-Za-z0-9_-]{1,64}$",
            "type": "string"
          },
          "data_class": {
            "$ref": "#/components/schemas/Case/$defs/DataClass"
          },
          "findings": {
            "description": "IDs must be unique. Runtime also limits serialized case size to 16384 bytes.",
            "items": {
              "$ref": "#/components/schemas/Case/$defs/Finding"
            },
            "maxItems": 64,
            "type": "array"
          },
          "schema_version": {
            "format": "uint32",
            "maximum": 1,
            "minimum": 1,
            "type": "integer"
          },
          "sex_at_birth": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/Case/$defs/SexAtBirth"
              },
              {
                "type": "null"
              }
            ]
          },
          "specimen_site": {
            "description": "Biopsy site, not necessarily the primary origin. Nonblank when supplied.",
            "maxLength": 128,
            "minLength": 1,
            "type": [
              "string",
              "null"
            ],
            "x-maxUtf8Bytes": 128
          }
        },
        "required": [
          "schema_version",
          "case_id",
          "data_class",
          "findings"
        ],
        "title": "Case",
        "type": "object"
      },
      "ErrorEnvelope": {
        "$defs": {
          "ErrorCode": {
            "enum": [
              "invalid_arguments",
              "invalid_json",
              "invalid_case",
              "input_too_large",
              "unsupported_media_type",
              "not_found",
              "method_not_allowed",
              "file_not_found",
              "output_exists",
              "io_error",
              "missing_api_key",
              "data_policy",
              "provider_transport",
              "provider_http",
              "provider_response",
              "terminal_required",
              "internal_error"
            ],
            "type": "string"
          },
          "ErrorDetail": {
            "properties": {
              "code": {
                "$ref": "#/components/schemas/ErrorEnvelope/$defs/ErrorCode"
              },
              "message": {
                "type": "string"
              }
            },
            "required": [
              "code",
              "message"
            ],
            "type": "object"
          }
        },
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "properties": {
          "error": {
            "$ref": "#/components/schemas/ErrorEnvelope/$defs/ErrorDetail"
          }
        },
        "required": [
          "error"
        ],
        "title": "ErrorEnvelope",
        "type": "object"
      },
      "HealthResponse": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "properties": {
          "live_classification": {
            "type": "boolean"
          },
          "mode": {
            "type": "string"
          },
          "status": {
            "type": "string"
          }
        },
        "required": [
          "status",
          "mode",
          "live_classification"
        ],
        "title": "HealthResponse",
        "type": "object"
      },
      "PreparedResponse": {
        "$defs": {
          "JevRequest": {
            "properties": {
              "model": {
                "type": "string"
              },
              "questions": {
                "additionalProperties": {
                  "$ref": "#/components/schemas/PreparedResponse/$defs/Question"
                },
                "type": "object"
              },
              "state": true
            },
            "required": [
              "model",
              "state",
              "questions"
            ],
            "type": "object"
          },
          "Question": {
            "oneOf": [
              {
                "properties": {
                  "criteria": {
                    "additionalProperties": {
                      "type": "string"
                    },
                    "type": "object"
                  },
                  "instructions": {
                    "type": "string"
                  },
                  "type": {
                    "const": "choice",
                    "type": "string"
                  }
                },
                "required": [
                  "type",
                  "instructions",
                  "criteria"
                ],
                "type": "object"
              },
              {
                "properties": {
                  "instructions": {
                    "type": "string"
                  },
                  "type": {
                    "const": "noul",
                    "type": "string"
                  }
                },
                "required": [
                  "type",
                  "instructions"
                ],
                "type": "object"
              }
            ]
          }
        },
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "properties": {
          "request": {
            "$ref": "#/components/schemas/PreparedResponse/$defs/JevRequest"
          },
          "research_only": {
            "type": "boolean"
          },
          "sends_to_provider": {
            "type": "boolean"
          }
        },
        "required": [
          "research_only",
          "sends_to_provider",
          "request"
        ],
        "title": "PreparedResponse",
        "type": "object"
      },
      "ResultRecord": {
        "$defs": {
          "RankedOrigin": {
            "properties": {
              "calibrated_probability": {
                "format": "double",
                "type": [
                  "number",
                  "null"
                ]
              },
              "origin": {
                "type": "string"
              },
              "raw_probability": {
                "format": "double",
                "type": "number"
              }
            },
            "required": [
              "origin",
              "raw_probability",
              "calibrated_probability"
            ],
            "type": "object"
          },
          "Source": {
            "enum": [
              "jev",
              "mock",
              "replay"
            ],
            "type": "string"
          },
          "Usage": {
            "properties": {
              "input_tokens": {
                "format": "uint64",
                "minimum": 0,
                "type": "integer"
              },
              "output_tokens": {
                "format": "uint64",
                "minimum": 0,
                "type": "integer"
              }
            },
            "required": [
              "input_tokens",
              "output_tokens"
            ],
            "type": "object"
          }
        },
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "properties": {
          "calibration_status": {
            "type": "string"
          },
          "case_id": {
            "type": "string"
          },
          "case_revision_sha256": {
            "type": "string"
          },
          "conflicting_evidence": {
            "format": "double",
            "type": "number"
          },
          "evidence_sufficient": {
            "format": "double",
            "type": "number"
          },
          "fingerprint_version": {
            "type": "string"
          },
          "model": {
            "type": "string"
          },
          "policy_version": {
            "type": "string"
          },
          "probability_kind": {
            "type": "string"
          },
          "prompt_version": {
            "type": "string"
          },
          "provider_confidence": {
            "format": "double",
            "type": "number"
          },
          "rankings": {
            "items": {
              "$ref": "#/components/schemas/ResultRecord/$defs/RankedOrigin"
            },
            "type": "array"
          },
          "reasons": {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "request_sha256": {
            "type": "string"
          },
          "research_only": {
            "type": "boolean"
          },
          "result_schema_version": {
            "format": "uint32",
            "minimum": 0,
            "type": "integer"
          },
          "source": {
            "$ref": "#/components/schemas/ResultRecord/$defs/Source"
          },
          "status": {
            "type": "string"
          },
          "taxonomy_version": {
            "type": "string"
          },
          "usage": {
            "$ref": "#/components/schemas/ResultRecord/$defs/Usage"
          }
        },
        "required": [
          "result_schema_version",
          "case_id",
          "case_revision_sha256",
          "fingerprint_version",
          "source",
          "status",
          "reasons",
          "research_only",
          "probability_kind",
          "calibration_status",
          "model",
          "prompt_version",
          "taxonomy_version",
          "policy_version",
          "request_sha256",
          "provider_confidence",
          "evidence_sufficient",
          "conflicting_evidence",
          "rankings",
          "usage"
        ],
        "title": "ResultRecord",
        "type": "object"
      }
    }
  },
  "info": {
    "description": "Research development. No live classification, authentication, persistence or clinical calibration.",
    "title": "Jev Onco Nexus offline research API",
    "version": "0.2.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/health": {
      "get": {
        "operationId": "health",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            },
            "description": "Local readiness only; Jev connectivity not checked"
          }
        }
      }
    },
    "/v1/demo": {
      "post": {
        "operationId": "demoCase",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Case"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ResultRecord"
                }
              }
            },
            "description": "Offline research result; no provider request"
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            },
            "description": "Malformed or trailing JSON"
          },
          "413": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            },
            "description": "Body exceeds 16384 bytes"
          },
          "415": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            },
            "description": "Unsupported media type"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            },
            "description": "Invalid case or JSON structure"
          },
          "default": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            },
            "description": "Structured failure"
          }
        }
      }
    },
    "/v1/prepare": {
      "post": {
        "operationId": "prepareCase",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Case"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PreparedResponse"
                }
              }
            },
            "description": "Offline research result; no provider request"
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            },
            "description": "Malformed or trailing JSON"
          },
          "413": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            },
            "description": "Body exceeds 16384 bytes"
          },
          "415": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            },
            "description": "Unsupported media type"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            },
            "description": "Invalid case or JSON structure"
          },
          "default": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            },
            "description": "Structured failure"
          }
        }
      }
    }
  },
  "servers": [
    {
      "url": "http://127.0.0.1:3000"
    }
  ]
}
