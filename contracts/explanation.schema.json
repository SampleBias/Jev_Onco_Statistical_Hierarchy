{
  "$defs": {
    "Algorithm": {
      "enum": [
        "exact",
        "permutation"
      ],
      "type": "string"
    },
    "Answer": {
      "oneOf": [
        {
          "properties": {
            "choice": {
              "type": "string"
            },
            "confidence": {
              "format": "double",
              "type": "number"
            },
            "probabilities": {
              "additionalProperties": {
                "format": "double",
                "type": "number"
              },
              "type": "object"
            },
            "type": {
              "const": "choice",
              "type": "string"
            }
          },
          "required": [
            "type",
            "choice",
            "probabilities",
            "confidence"
          ],
          "type": "object"
        },
        {
          "properties": {
            "noul": {
              "format": "double",
              "type": "number"
            },
            "type": {
              "const": "noul",
              "type": "string"
            }
          },
          "required": [
            "type",
            "noul"
          ],
          "type": "object"
        }
      ]
    },
    "Attribution": {
      "additionalProperties": false,
      "properties": {
        "contribution": {
          "format": "double",
          "type": "number"
        },
        "feature_ids": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "group": {
          "type": "string"
        },
        "label": {
          "type": "string"
        },
        "modalities": {
          "items": {
            "$ref": "#/$defs/Modality"
          },
          "type": "array"
        },
        "sampling_standard_error": {
          "description": "Monte Carlo standard error over paired permutations; not a clinical interval.",
          "format": "double",
          "type": [
            "number",
            "null"
          ]
        }
      },
      "required": [
        "group",
        "feature_ids",
        "label",
        "modalities",
        "contribution"
      ],
      "type": "object"
    },
    "Background": {
      "additionalProperties": false,
      "properties": {
        "partition": {
          "type": "string"
        },
        "release_id": {
          "type": "string"
        },
        "samples": {
          "items": {
            "$ref": "#/$defs/FeatureSet"
          },
          "type": "array"
        }
      },
      "required": [
        "release_id",
        "partition",
        "samples"
      ],
      "type": "object"
    },
    "Baseline": {
      "enum": [
        "masked_evidence",
        "reference_background"
      ],
      "type": "string"
    },
    "CancerClass": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "parent": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "name",
        "parent"
      ],
      "type": "object"
    },
    "Config": {
      "additionalProperties": false,
      "properties": {
        "algorithm": {
          "$ref": "#/$defs/Algorithm"
        },
        "baseline": {
          "$ref": "#/$defs/Baseline"
        },
        "max_evaluations": {
          "format": "uint",
          "minimum": 0,
          "type": "integer"
        },
        "max_input_tokens": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "max_seconds": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "permutation_pairs": {
          "format": "uint",
          "minimum": 0,
          "type": "integer"
        },
        "seed": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "target_class": {
          "type": "string"
        }
      },
      "required": [
        "algorithm",
        "baseline",
        "target_class",
        "permutation_pairs",
        "seed",
        "max_evaluations",
        "max_input_tokens",
        "max_seconds"
      ],
      "type": "object"
    },
    "DataClass": {
      "enum": [
        "synthetic",
        "deidentified_research"
      ],
      "type": "string"
    },
    "Evaluation": {
      "additionalProperties": false,
      "properties": {
        "request": {
          "$ref": "#/$defs/JevRequest"
        },
        "response": {
          "$ref": "#/$defs/JevResponse"
        }
      },
      "required": [
        "request",
        "response"
      ],
      "type": "object"
    },
    "ExplanationResult": {
      "additionalProperties": false,
      "properties": {
        "additivity_residual": {
          "format": "double",
          "type": "number"
        },
        "attributions": {
          "items": {
            "$ref": "#/$defs/Attribution"
          },
          "type": "array"
        },
        "background_sha256": {
          "type": [
            "string",
            "null"
          ]
        },
        "baseline_probability": {
          "format": "double",
          "type": "number"
        },
        "evaluations": {
          "format": "uint",
          "minimum": 0,
          "type": "integer"
        },
        "full_probability": {
          "format": "double",
          "type": "number"
        },
        "input_tokens": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "limitations": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "method": {
          "type": "string"
        },
        "target_class": {
          "type": "string"
        }
      },
      "required": [
        "method",
        "target_class",
        "baseline_probability",
        "full_probability",
        "attributions",
        "additivity_residual",
        "evaluations",
        "input_tokens",
        "limitations"
      ],
      "type": "object"
    },
    "Feature": {
      "additionalProperties": false,
      "properties": {
        "assay": {
          "type": "string"
        },
        "coverage": {
          "description": "Unknown coverage is distinct from an observed absence.",
          "type": "string"
        },
        "depends_on": {
          "default": [],
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "group": {
          "description": "Features sharing a group are replaced together; dependencies must be in this group.",
          "type": "string"
        },
        "id": {
          "type": "string"
        },
        "modality": {
          "$ref": "#/$defs/Modality"
        },
        "name": {
          "type": "string"
        },
        "reference_build": {
          "type": [
            "string",
            "null"
          ]
        },
        "source": {
          "$ref": "#/$defs/FeatureSource"
        },
        "status": {
          "$ref": "#/$defs/MeasurementStatus"
        },
        "value": {
          "anyOf": [
            {
              "$ref": "#/$defs/FeatureValue"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "id",
        "name",
        "modality",
        "group",
        "status",
        "assay",
        "coverage",
        "source"
      ],
      "type": "object"
    },
    "FeatureSet": {
      "additionalProperties": false,
      "properties": {
        "data_class": {
          "$ref": "#/$defs/DataClass"
        },
        "features": {
          "items": {
            "$ref": "#/$defs/Feature"
          },
          "type": "array"
        },
        "patient_group_id": {
          "type": "string"
        },
        "pipeline_version": {
          "type": "string"
        },
        "sample_id": {
          "type": "string"
        },
        "schema_version": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "schema_version",
        "pipeline_version",
        "sample_id",
        "patient_group_id",
        "data_class",
        "features"
      ],
      "type": "object"
    },
    "FeatureSource": {
      "additionalProperties": false,
      "properties": {
        "record": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "sha256": {
          "type": "string"
        },
        "source_id": {
          "type": "string"
        }
      },
      "required": [
        "source_id",
        "sha256",
        "record"
      ],
      "type": "object"
    },
    "FeatureValue": {
      "oneOf": [
        {
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "number",
              "type": "string"
            },
            "units": {
              "type": "string"
            },
            "value": {
              "format": "double",
              "type": "number"
            }
          },
          "required": [
            "kind",
            "value",
            "units"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "category",
              "type": "string"
            },
            "value": {
              "type": "string"
            }
          },
          "required": [
            "kind",
            "value"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "alternate": {
              "type": "string"
            },
            "chromosome": {
              "type": "string"
            },
            "consequence": {
              "type": "string"
            },
            "gene": {
              "type": "string"
            },
            "kind": {
              "const": "mutation",
              "type": "string"
            },
            "position": {
              "format": "uint64",
              "minimum": 0,
              "type": "integer"
            },
            "reference": {
              "type": "string"
            },
            "somatic": {
              "type": [
                "boolean",
                "null"
              ]
            }
          },
          "required": [
            "kind",
            "gene",
            "chromosome",
            "position",
            "reference",
            "alternate",
            "consequence"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "call": {
              "format": "int8",
              "maximum": 127,
              "minimum": -128,
              "type": "integer"
            },
            "gene": {
              "type": "string"
            },
            "kind": {
              "const": "copy_number",
              "type": "string"
            }
          },
          "required": [
            "kind",
            "gene",
            "call"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "catalogue": {
              "type": "string"
            },
            "kind": {
              "const": "signature",
              "type": "string"
            },
            "method": {
              "type": "string"
            },
            "mutation_count": {
              "format": "uint64",
              "minimum": 0,
              "type": "integer"
            },
            "signature": {
              "type": "string"
            },
            "units": {
              "type": "string"
            },
            "value": {
              "format": "double",
              "type": "number"
            }
          },
          "required": [
            "kind",
            "signature",
            "value",
            "units",
            "catalogue",
            "method",
            "mutation_count"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "An inseparable vector, e.g. all reference similarities or compositional signatures.",
          "properties": {
            "kind": {
              "const": "vector",
              "type": "string"
            },
            "reference_sha256": {
              "type": "string"
            },
            "units": {
              "type": "string"
            },
            "values": {
              "additionalProperties": {
                "format": "double",
                "type": "number"
              },
              "type": "object"
            }
          },
          "required": [
            "kind",
            "values",
            "units",
            "reference_sha256"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "age",
              "type": "string"
            },
            "lower_bound_exclusive": {
              "type": "boolean"
            },
            "years": {
              "format": "uint8",
              "maximum": 255,
              "minimum": 0,
              "type": "integer"
            }
          },
          "required": [
            "kind",
            "years",
            "lower_bound_exclusive"
          ],
          "type": "object"
        }
      ]
    },
    "InferenceRun": {
      "additionalProperties": false,
      "properties": {
        "calibration_status": {
          "type": "string"
        },
        "feature_sha256": {
          "type": "string"
        },
        "prompt_version": {
          "type": "string"
        },
        "reasons": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "request": {
          "$ref": "#/$defs/JevRequest"
        },
        "request_sha256": {
          "type": "string"
        },
        "response": {
          "$ref": "#/$defs/JevResponse"
        },
        "schema_version": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "source": {
          "$ref": "#/$defs/Source"
        },
        "status": {
          "type": "string"
        },
        "taxonomy": {
          "$ref": "#/$defs/TaxonomyDefinition"
        }
      },
      "required": [
        "schema_version",
        "prompt_version",
        "feature_sha256",
        "taxonomy",
        "request_sha256",
        "request",
        "response",
        "source",
        "status",
        "reasons",
        "calibration_status"
      ],
      "type": "object"
    },
    "JevRequest": {
      "properties": {
        "model": {
          "type": "string"
        },
        "questions": {
          "additionalProperties": {
            "$ref": "#/$defs/Question"
          },
          "type": "object"
        },
        "state": true
      },
      "required": [
        "model",
        "state",
        "questions"
      ],
      "type": "object"
    },
    "JevResponse": {
      "properties": {
        "answers": {
          "additionalProperties": {
            "$ref": "#/$defs/Answer"
          },
          "type": "object"
        },
        "model": {
          "type": "string"
        },
        "usage": {
          "$ref": "#/$defs/Usage"
        }
      },
      "required": [
        "model",
        "answers",
        "usage"
      ],
      "type": "object"
    },
    "MeasurementStatus": {
      "enum": [
        "observed",
        "unknown",
        "not_tested"
      ],
      "type": "string"
    },
    "Modality": {
      "enum": [
        "mutation",
        "copy_number",
        "signature",
        "demographic",
        "expression",
        "ihc",
        "histology"
      ],
      "type": "string"
    },
    "NoulCriteria": {
      "description": "Optional yes/no boundary. Omitted from JSON when absent so older requests stay byte-identical.",
      "properties": {
        "false": {
          "type": "string"
        },
        "true": {
          "type": "string"
        }
      },
      "required": [
        "true",
        "false"
      ],
      "type": "object"
    },
    "Question": {
      "oneOf": [
        {
          "properties": {
            "criteria": {
              "additionalProperties": {
                "type": "string"
              },
              "type": "object"
            },
            "instructions": {
              "type": "string"
            },
            "type": {
              "const": "choice",
              "type": "string"
            }
          },
          "required": [
            "type",
            "instructions",
            "criteria"
          ],
          "type": "object"
        },
        {
          "properties": {
            "criteria": {
              "anyOf": [
                {
                  "$ref": "#/$defs/NoulCriteria"
                },
                {
                  "type": "null"
                }
              ]
            },
            "instructions": {
              "type": "string"
            },
            "type": {
              "const": "noul",
              "type": "string"
            }
          },
          "required": [
            "type",
            "instructions"
          ],
          "type": "object"
        }
      ]
    },
    "Source": {
      "enum": [
        "jev",
        "mock",
        "replay"
      ],
      "type": "string"
    },
    "TaxonomyDefinition": {
      "additionalProperties": false,
      "properties": {
        "classes": {
          "items": {
            "$ref": "#/$defs/CancerClass"
          },
          "type": "array"
        },
        "other_id": {
          "type": "string"
        },
        "unknown_id": {
          "type": "string"
        },
        "version": {
          "type": "string"
        }
      },
      "required": [
        "version",
        "classes",
        "unknown_id",
        "other_id"
      ],
      "type": "object"
    },
    "Usage": {
      "properties": {
        "input_tokens": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "output_tokens": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "input_tokens",
        "output_tokens"
      ],
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "attempts": {
      "format": "uint",
      "minimum": 0,
      "type": "integer"
    },
    "background": {
      "anyOf": [
        {
          "$ref": "#/$defs/Background"
        },
        {
          "type": "null"
        }
      ]
    },
    "config": {
      "$ref": "#/$defs/Config"
    },
    "evaluations": {
      "additionalProperties": {
        "$ref": "#/$defs/Evaluation"
      },
      "type": "object"
    },
    "features": {
      "$ref": "#/$defs/FeatureSet"
    },
    "in_flight": {
      "anyOf": [
        {
          "$ref": "#/$defs/JevRequest"
        },
        {
          "type": "null"
        }
      ]
    },
    "inference": {
      "$ref": "#/$defs/InferenceRun"
    },
    "result": {
      "anyOf": [
        {
          "$ref": "#/$defs/ExplanationResult"
        },
        {
          "type": "null"
        }
      ]
    },
    "schema_version": {
      "format": "uint32",
      "minimum": 0,
      "type": "integer"
    },
    "uncertain_input_tokens": {
      "format": "uint64",
      "minimum": 0,
      "type": "integer"
    }
  },
  "required": [
    "schema_version",
    "features",
    "inference",
    "config",
    "evaluations",
    "attempts",
    "uncertain_input_tokens"
  ],
  "title": "Archive",
  "type": "object"
}
