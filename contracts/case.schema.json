{
  "$defs": {
    "CaseMetadata": {
      "additionalProperties": false,
      "properties": {
        "evidence_cutoff": {
          "type": [
            "string",
            "null"
          ]
        },
        "institution_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "patient_id": {
          "description": "Local group ID for cohort partitioning; never sent to Jev.",
          "type": [
            "string",
            "null"
          ]
        },
        "sample_id": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "type": "object"
    },
    "DataClass": {
      "enum": [
        "synthetic",
        "deidentified_research"
      ],
      "type": "string"
    },
    "EvidenceKind": {
      "enum": [
        "histology",
        "ihc",
        "molecular",
        "clinical"
      ],
      "type": "string"
    },
    "Finding": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "pattern": "^[A-Za-z0-9_-]{1,64}$",
          "type": "string"
        },
        "kind": {
          "$ref": "#/$defs/EvidenceKind"
        },
        "name": {
          "description": "Nonblank; limit is measured in UTF-8 bytes by the runtime validator.",
          "maxLength": 128,
          "minLength": 1,
          "type": "string",
          "x-maxUtf8Bytes": 128
        },
        "observation": {
          "anyOf": [
            {
              "$ref": "#/$defs/Observation"
            },
            {
              "type": "null"
            }
          ]
        },
        "source": {
          "anyOf": [
            {
              "$ref": "#/$defs/SourceReference"
            },
            {
              "type": "null"
            }
          ],
          "description": "Local provenance. Excluded from the provider state."
        },
        "value": {
          "description": "Nonblank; limit is measured in UTF-8 bytes by the runtime validator.",
          "maxLength": 1024,
          "minLength": 1,
          "type": "string",
          "x-maxUtf8Bytes": 1024
        }
      },
      "required": [
        "id",
        "kind",
        "name",
        "value"
      ],
      "type": "object"
    },
    "Observation": {
      "additionalProperties": false,
      "properties": {
        "assay": {
          "type": [
            "string",
            "null"
          ]
        },
        "reference_build": {
          "type": [
            "string",
            "null"
          ]
        },
        "status": {
          "$ref": "#/$defs/ObservationStatus"
        },
        "timepoint": {
          "description": "Relative study timepoint; do not put direct identifiers here.",
          "type": [
            "string",
            "null"
          ]
        },
        "units": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "status"
      ],
      "type": "object"
    },
    "ObservationStatus": {
      "enum": [
        "observed",
        "positive",
        "negative",
        "equivocal",
        "not_tested",
        "unknown"
      ],
      "type": "string"
    },
    "SexAtBirth": {
      "enum": [
        "female",
        "male",
        "intersex",
        "unknown"
      ],
      "type": "string"
    },
    "SourceReference": {
      "additionalProperties": false,
      "properties": {
        "field": {
          "type": "string"
        },
        "record": {
          "description": "One-based input record; CSV/TSV header is record 1. Not a physical line number.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "source_id": {
          "type": "string"
        },
        "source_sha256": {
          "type": "string"
        }
      },
      "required": [
        "source_id",
        "source_sha256",
        "record",
        "field"
      ],
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "allOf": [
    {
      "else": {
        "properties": {
          "age_lower_bound_exclusive": {
            "type": "null"
          },
          "findings": {
            "items": {
              "properties": {
                "observation": {
                  "type": "null"
                },
                "source": {
                  "type": "null"
                }
              }
            }
          },
          "metadata": {
            "type": "null"
          }
        }
      },
      "if": {
        "properties": {
          "schema_version": {
            "const": 2
          }
        }
      },
      "then": {
        "properties": {
          "findings": {
            "items": {
              "properties": {
                "observation": {
                  "type": "object"
                },
                "source": {
                  "type": "object"
                }
              },
              "required": [
                "source",
                "observation"
              ]
            }
          },
          "metadata": {
            "type": "object"
          }
        },
        "required": [
          "metadata"
        ]
      }
    }
  ],
  "properties": {
    "age_lower_bound_exclusive": {
      "description": "Schema 2: preserve censored ages such as >89 without treating them as exact.",
      "format": "uint8",
      "maximum": 119,
      "minimum": 0,
      "type": [
        "integer",
        "null"
      ]
    },
    "age_years": {
      "format": "uint8",
      "maximum": 120,
      "minimum": 0,
      "type": [
        "integer",
        "null"
      ]
    },
    "case_id": {
      "pattern": "^[A-Za-z0-9_-]{1,64}$",
      "type": "string"
    },
    "data_class": {
      "$ref": "#/$defs/DataClass"
    },
    "findings": {
      "description": "IDs must be unique. Runtime also limits serialized case size to 16384 bytes.",
      "items": {
        "$ref": "#/$defs/Finding"
      },
      "maxItems": 64,
      "type": "array"
    },
    "metadata": {
      "anyOf": [
        {
          "$ref": "#/$defs/CaseMetadata"
        },
        {
          "type": "null"
        }
      ],
      "description": "Schema 2 local metadata; never included in the provider state."
    },
    "schema_version": {
      "format": "uint32",
      "maximum": 2,
      "minimum": 1,
      "type": "integer"
    },
    "sex_at_birth": {
      "anyOf": [
        {
          "$ref": "#/$defs/SexAtBirth"
        },
        {
          "type": "null"
        }
      ]
    },
    "specimen_site": {
      "description": "Biopsy site, not necessarily the primary origin. Nonblank when supplied.",
      "maxLength": 128,
      "minLength": 1,
      "type": [
        "string",
        "null"
      ],
      "x-maxUtf8Bytes": 128
    }
  },
  "required": [
    "schema_version",
    "case_id",
    "data_class",
    "findings"
  ],
  "title": "Case",
  "type": "object"
}
